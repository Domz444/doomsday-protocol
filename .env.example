# Copy to .env and fill in.
#
# Local development — your existing local Mongo works fine:
#   MONGODB_URI=mongodb://localhost:27017
#
# Production on Vercel — must be reachable from the internet, so use a
# MongoDB Atlas cluster (free M0 tier is plenty). Vercel cannot reach a
# database running on your PC.
#   MONGODB_URI=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=doomsday
